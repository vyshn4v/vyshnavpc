{
  "name": "personalwebsite",
  "version": "3.0.3",
  "type": "module",
  "description": "an hbs server for personal website for mr.vyshnav p c",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "tailwind": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/tailwind-output.css --watch",
    "server": "node --env-file=./src/.env.local --watch ./src/index.js",
    "start:dev": "concurrently \"npm run server\" \"npm run tailwind\"",
    "build:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/tailwind-output.css --minify",
    "start:prod": "node --env-file=./src/.env --max-old-space-size=96 --optimize-for-size ./src/index.js"
  },
  "keywords": [
    "personal-website"
  ],
  "author": "vyshnav p c",
  "license": "ISC",
  "dependencies": {
    "amqplib": "^2.0.1",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "express-handlebars": "^8.0.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "mongoose": "^9.4.1",
    "rate-limit-redis": "^5.0.0",
    "redis": "^5.12.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.3",
    "tailwindcss": "^3.4.17"
  }
}
