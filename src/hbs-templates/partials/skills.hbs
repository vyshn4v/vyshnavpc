<div class="flex flex-col gap-3">
  {{#each skills.groups}}
  <article class="flex flex-col gap-1 pb-2 border-b border-gray-300 last:border-0 last:pb-0">
    <h3 class="text-sm font-bold font-serif text-brand-red uppercase tracking-wide">{{this.label}}</h3>
    <div class="text-xs font-serif text-slate-800 leading-relaxed text-justify">
      {{#each this.items}}
        <span class="inline-block mr-2 mb-1 border-b border-dotted border-slate-400 pb-0.5">{{this.name}}</span>
      {{/each}}
    </div>
  </article>
  {{/each}}
</div>