<div class="flex flex-col gap-4">
  {{#each experience}}
  <article class="flex flex-col border-b border-gray-300 pb-4 last:border-0 last:pb-0">
    
    <div class="flex items-baseline justify-between mb-1">
      <h3 class="text-lg font-serif font-bold text-primary">{{this.company}}</h3>
      <span class="text-[9px] font-bold tracking-widest uppercase text-slate-500">{{this.period}}</span>
    </div>
    
    <div class="text-sm font-bold text-brand-red uppercase tracking-wide mb-3">{{this.role}}</div>
    
    <div class="text-xs font-serif text-slate-800 leading-relaxed text-justify columns-1">
      <ul class="list-disc pl-4 space-y-2">
        {{#each this.highlights}}
        <li class="pl-1">{{this}}</li>
        {{/each}}
      </ul>
    </div>
    
  </article>
  {{/each}}
</div>