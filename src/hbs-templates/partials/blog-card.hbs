<article class="flex flex-col relative group border-t-2 border-gray-300 pt-4 filter-item {{#if featured}}border-primary border-t-4{{/if}}" data-category="{{category.slug}}">
  <a href="/blogs/{{#if slug}}{{slug}}{{else}}{{_id}}{{/if}}" class="absolute inset-0 z-10" aria-label="Read {{title}}"><span class="sr-only">Read More</span></a>

  <div class="flex flex-col flex-grow relative z-0">
    <div class="flex justify-between items-start mb-2">
      <span class="text-[9px] font-bold tracking-widest uppercase text-brand-red">
        {{category.icon}} {{category.label}}
      </span>
      {{#if featured}}
        <span class="text-[9px] font-bold tracking-widest uppercase text-white bg-brand-red px-2 py-0.5">Featured</span>
      {{/if}}
    </div>

    <h3 class="text-xl font-serif font-bold text-primary mb-2 group-hover:underline transition-all">{{title}}</h3>
    <p class="text-sm font-serif text-slate-700 leading-relaxed text-justify mb-3 line-clamp-3">{{excerpt}}</p>

    <div class="flex items-center gap-2 mt-auto text-[10px] font-sans font-bold uppercase tracking-widest text-slate-500">
      <span>{{date}}</span>
      <span>•</span>
      <span>{{readTime}}</span>
    </div>
  </div>
</article>
