<div class="w-full">
  <!-- Content Body -->
  <div class="flex flex-col md:flex-row gap-8">
    <!-- Left: Text -->
    <div class="flex-1 text-justify font-serif text-slate-800 text-sm leading-relaxed">
      {{#each about.bio_paragraphs}}
      <p class="mb-4 {{#if @first}}first-letter:text-6xl first-letter:font-black first-letter:float-left first-letter:mr-3 first-letter:mt-2 first-letter:leading-none{{/if}}">
        {{this}}
      </p>
      {{/each}}
    </div>

    <!-- Right: Feature Photo -->
    <div class="w-32 md:w-48 shrink-0 flex flex-col border border-gray-300 bg-white p-1 md:p-2 shadow-sm">
      <img src="/vyshnav_p_c.jpg" alt="Vyshnav P C" class="w-full h-auto object-cover pb-1 md:pb-2">
      <div class="border-t border-gray-300 pt-1 md:pt-2 pb-1 px-1">
        <div class="text-[8px] md:text-[9px] font-sans text-slate-600 uppercase tracking-widest leading-tight text-justify">
          <span class="font-bold text-primary">PORTRAIT:</span> Fullstack developer Vyshnav P C.
        </div>
      </div>
    </div>
  </div>

  {{#if about.achievements}}
  <div class="mt-4 border-t border-b border-gray-300 py-4 mb-4">
    <h3 class="text-xs font-bold text-slate-500 uppercase tracking-widest mb-4">Key Achievements</h3>
    <ul class="flex flex-col gap-3">
      {{#each about.achievements}}
      <li class="flex gap-4 items-start">
        <span class="text-xl shrink-0 opacity-80">{{this.icon}}</span>
        <div>
          <div class="text-sm font-bold font-serif text-primary mb-0.5 leading-tight">{{this.title}}</div>
          <div class="text-xs font-sans text-slate-600">{{this.desc}}</div>
        </div>
      </li>
      {{/each}}
    </ul>
  </div>
  {{/if}}
</div>