<article class="flex flex-col group border-t-2 border-background-border pt-6">
  {{#if this.image}}
  <div class="aspect-video w-full overflow-hidden mb-6 bg-slate-100 border border-slate-200">
    <img src="{{this.image}}" alt="{{this.title}}" loading="lazy" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700">
  </div>
  {{/if}}
  
  <div class="flex flex-col flex-grow">
    <h3 class="text-xl font-serif font-bold text-primary mb-3 group-hover:text-slate-600 transition-colors">{{this.title}}</h3>
    <p class="text-sm text-slate-600 mb-6 flex-grow line-clamp-4 leading-relaxed">{{this.description}}</p>
    
    {{#if this.technologies}}
    <div class="flex flex-wrap gap-2 mb-8">
      {{#each this.technologies}}
      <span class="px-3 py-1 text-[11px] font-semibold tracking-wide text-slate-600 border border-slate-200 bg-slate-50">{{this}}</span>
      {{/each}}
    </div>
    {{/if}}

    <div class="flex items-center gap-4 mt-auto border-t border-slate-200 pt-6">
      {{#if this.github}}
      <a href="{{this.github}}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 bg-transparent text-primary hover:bg-slate-50 font-semibold uppercase tracking-wider py-2 px-6 text-xs transition-colors border border-primary flex-1">
        Code
      </a>
      {{/if}}
      
      {{#if this.live}}
      <a href="{{this.live}}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 bg-primary text-white hover:bg-slate-700 font-semibold uppercase tracking-wider py-2 px-6 text-xs transition-colors border border-primary flex-1">
        Demo
      </a>
      {{else if this.live_link}}
      <a href="{{this.live_link}}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 bg-primary text-white hover:bg-slate-700 font-semibold uppercase tracking-wider py-2 px-6 text-xs transition-colors border border-primary flex-1">
        Demo
      </a>
      {{else if this.link}}
      <a href="{{this.link}}" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 bg-transparent text-primary hover:bg-slate-50 font-semibold uppercase tracking-wider py-2 px-6 text-xs transition-colors border border-primary flex-1">
        Link
      </a>
      {{/if}}
    </div>
  </div>
</article>
