<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  {{#each certificates}}
  <article class="flex flex-col border border-gray-300 p-4 relative group">
    
    <div class="text-[9px] font-bold tracking-widest uppercase text-brand-blue mb-2">{{this.issuer}}</div>
    
    <h3 class="text-sm font-serif font-bold text-primary mb-2 leading-tight group-hover:underline">{{this.name}}</h3>
    
    <div class="flex items-center justify-between mt-auto">
      <span class="text-xs font-serif text-slate-600">{{this.issued}}</span>
      
      {{#if this.credentialUrl}}
      <a href="{{this.credentialUrl}}" target="_blank" rel="noopener noreferrer" class="text-[10px] font-sans font-bold uppercase tracking-widest text-slate-500 hover:text-primary transition-colors flex items-center gap-1">
        Verify
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
      </a>
      {{/if}}
    </div>
    
  </article>
  {{/each}}
</div>
