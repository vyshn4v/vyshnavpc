<div class="flex flex-col border-t-2 border-primary pt-6">
  {{#each journey.steps}}
    <article class="grid grid-cols-1 md:grid-cols-[140px_1fr] gap-6 mb-8 border-b border-gray-300 pb-8 last:border-0 last:pb-0">
      
      <!-- Year/Date Column -->
      <div class="text-[10px] font-bold tracking-widest text-brand-red flex flex-col pt-1 border-b md:border-b-0 md:border-r border-gray-300 pb-4 md:pb-0 md:pr-4 mb-4 md:mb-0">
        <span class="text-3xl font-head font-black text-primary">{{this.year}}</span>
        <div class="mt-2 text-slate-500 uppercase">{{this.tag}}</div>
      </div>
      
      <!-- Content Column -->
      <div class="flex flex-col">
        <h3 class="text-2xl font-serif font-bold text-primary mb-3 leading-tight">{{this.title}}</h3>
        <p class="text-sm font-serif text-slate-800 leading-relaxed text-justify mb-4">{{this.description}}</p>
        
        {{#if this.metrics}}
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4 border-y border-gray-200 py-3">
            {{#each this.metrics}}
              <div class="flex flex-col">
                <span class="text-lg font-bold font-serif text-primary">{{this.value}}</span>
                <span class="text-[9px] uppercase tracking-widest text-slate-500">{{this.label}}</span>
              </div>
            {{/each}}
          </div>
        {{/if}}

        {{#if this.skills}}
          <div class="text-[9px] font-sans font-bold uppercase tracking-widest text-slate-500 flex flex-wrap gap-x-3 gap-y-1 mt-2">
            {{#each this.skills}}
              <span>{{this}}</span>
            {{/each}}
          </div>
        {{/if}}
      </div>
    </article>
  {{/each}}
</div>