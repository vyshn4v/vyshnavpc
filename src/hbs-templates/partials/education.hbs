<div class="flex flex-col gap-4">
  {{#each education}}
  <article class="flex flex-col border-b border-gray-300 pb-4 last:border-0 last:pb-0">
    
    <div class="flex items-baseline justify-between mb-0.5">
      <h3 class="text-lg font-serif font-bold text-primary">{{this.institution}}</h3>
      <span class="text-[9px] font-bold tracking-widest uppercase text-slate-500">{{this.period}}</span>
    </div>
    
    <div class="text-sm font-bold text-brand-red uppercase tracking-wide mb-1">{{this.title}}</div>
    
    {{#if this.subtitle}}
      <p class="text-xs font-serif text-slate-800 leading-relaxed text-justify mb-2">{{this.subtitle}}</p>
    {{/if}}
    
    {{#if this.tags}}
    <div class="text-[10px] font-sans font-bold uppercase tracking-widest text-slate-500">
      {{#each this.tags}}
      <span class="mr-2">{{this}}</span>
      {{/each}}
    </div>
    {{/if}}
    
  </article>
  {{/each}}
</div>