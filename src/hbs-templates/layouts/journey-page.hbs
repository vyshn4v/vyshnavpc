        <li class="pl-4"><a href="/#about" class="hover:text-slate-500">About</a></li>
        <li class="pl-4"><a href="/#projects" class="hover:text-slate-500">Projects</a></li>
        <li class="pl-4"><a href="/#experience" class="hover:text-slate-500">Experience</a></li>
        <li class="pl-4"><a href="/#education" class="hover:text-slate-500">Education</a></li>
        <li class="pl-4"><a href="/#skills" class="hover:text-slate-500">Skills</a></li>
        <li class="pl-4"><a href="/blogs" class="hover:text-slate-500">Blogs</a></li>
        <li class="pl-4"><a href="/journey" class="hover:text-slate-500">Journey</a></li>
        <li class="pl-4"><a href="#" class="trigger-contact-modal hover:text-slate-500">Contact</a></li>
      </ul>
    </div>
  </div>
  
  <div class="max-w-4xl mx-auto">
    {{> journey}}
