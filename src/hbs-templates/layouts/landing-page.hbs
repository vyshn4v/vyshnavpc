<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-12 mt-4">
  
  <!-- Hero Section (Full Width Headline) -->
  <section id="home" class="text-center lg:text-left border-b-4 border-primary pb-6">
    {{> hero}}
  </section>

  <!-- Main Newspaper Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mt-4">
    
    <!-- Main Left Content (About, Projects, etc) -->
    <main class="lg:col-span-8 flex flex-col lg:pr-6 lg:border-r border-gray-300">

      <section id="about" class="mb-8">
        {{> about}}
      </section>

      <div class="w-full h-[1px] bg-gray-300 mb-6"></div>

      <section id="projects" class="mb-8">
        <h2 class="text-3xl font-head font-black text-primary mb-6 tracking-tighter border-b-2 border-primary pb-2">Latest Development Reports</h2>
        {{> projects}}
      </section>

      <div class="w-full h-[1px] bg-gray-300 mb-6"></div>

      <section id="certificates" class="mb-8">
        <h2 class="text-3xl font-head font-black text-primary mb-6 tracking-tighter border-b-2 border-primary pb-2">Certifications</h2>
        {{> certificates}}
      </section>
      
    </main>

    <!-- Side Content (Experience, Skills, Education) -->
    <aside class="lg:col-span-4 flex flex-col">
      <section id="experience" class="mb-8">
        <h2 class="text-2xl font-head font-black text-primary mb-4 tracking-tighter border-b-2 border-primary pb-2">Professional Career</h2>
        {{> experience}}
      </section>

      <div class="w-full h-[1px] bg-gray-300 mb-6"></div>

      <section id="skills" class="mb-8">
        <h2 class="text-2xl font-head font-black text-primary mb-4 tracking-tighter border-b-2 border-primary pb-2">Technical Arsenal</h2>
        {{> skills}}
      </section>

      <div class="w-full h-[1px] bg-gray-300 mb-6"></div>

      <section id="education" class="mb-8">
        <h2 class="text-2xl font-head font-black text-primary mb-4 tracking-tighter border-b-2 border-primary pb-2">Academic Record</h2>
        {{> education}}
      </section>
    </aside>
  </div>
</div>
