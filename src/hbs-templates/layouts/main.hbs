          }
        ]
      }
      </script>
    {{/if}}
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    {{#if is_post}}
    <link rel="stylesheet" href="/css/post.css?v=6" />
    <link rel="stylesheet" href="/css/post-mongo.css?v=6" />
    {{/if}}

    <!-- Tailwind CSS Output (Cache-busted) -->
    <link rel="stylesheet" href="/css/tailwind-output.css?v=29" />

    {{{_sections.styles}}}

  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-T4R9GT7H"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    
    {{> nav}}

    <main>
      {{{body}}}
    </main>
    {{> footer}}

    <!-- Global Contact Modal -->

    {{> contact}}

    {{{_sections.scripts}}}
    
    <!-- GSAP Libraries -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // Handle trigger-contact-modal class for nav links
        const triggers = document.querySelectorAll(".trigger-contact-modal");
        const modalBackdrop = document.getElementById("modalBackdrop");
        
        if (modalBackdrop) {
          const openModal = (e) => {
            if (e) e.preventDefault();
            modalBackdrop.classList.remove("hidden");
            document.body.classList.add("overflow-hidden");
          };
          
          triggers.forEach(trigger => {
            trigger.addEventListener("click", openModal);
          });
        }
      });
    </script>

    <!-- Cookie Consent Banner -->
    <div id="cookieConsentBanner" class="fixed bottom-4 left-4 max-w-sm bg-[#111118] border border-white/10 shadow-2xl rounded-xl p-6 z-[9999] transform translate-y-8 opacity-0 pointer-events-none transition-all duration-500">
      <div>
        <p class="text-xs text-slate-300 mb-4 leading-relaxed font-serif">
          This website uses Google Analytics and Microsoft Clarity to understand how visitors interact with the site and improve the experience. 
          By continuing to use the site, you agree to these data collection policies. 
          <a href="https://www.microsoft.com/privacy/privacystatement" target="_blank" rel="noopener noreferrer" class="text-primary underline hover:text-white transition-colors">Learn more</a>.
        </p>
        <div class="flex gap-3">
          <button id="acceptCookies" class="w-full bg-primary hover:bg-primary/80 text-white font-bold py-2.5 px-4 rounded-lg text-sm transition-colors font-sans">Got it</button>
        </div>
      </div>
    </div>

    <script src="/js/main.js?v=9"></script>
    <script src="/js/gsap-animations.js?v=1"></script>

    <script>
      // Lazy-load all scripts on interaction (Informational consent mode)
      (function() {
        let essentialLoaded = false;
        
        function loadEssentialScripts() {
          if (essentialLoaded) return;
          essentialLoaded = true;
          
          // Turnstile
          const ts = document.createElement('script');
          ts.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
          ts.async = true;
          ts.defer = true;
          document.head.appendChild(ts);
        }
        
        ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'].forEach(function(e) {
          window.addEventListener(e, loadEssentialScripts, { once: true, passive: true });
        });

        // Tracking Scripts Logic
        let trackingLoaded = false;
        
        function loadTrackingScripts() {
          if (trackingLoaded) return;
          trackingLoaded = true;
          
          // GA4
          const ga = document.createElement('script');
          ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-T3JV9SSWP5';
          ga.async = true;
          document.head.appendChild(ga);
          window.dataLayer = window.dataLayer || [];
          function gtag(){window.dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-T3JV9SSWP5');
          
          // GTM
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer','GTM-T4R9GT7H');

          {{#if clarityId}}
          // Microsoft Clarity
          (function(c,l,a,r,i,t,y){
              c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
              t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
              y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "{{clarityId}}");
          {{/if}}
        }

        // Always load tracking scripts on interaction, since consent is informational only
        ['scroll', 'mousemove', 'touchstart', 'keydown', 'click'].forEach(function(e) {
          window.addEventListener(e, loadTrackingScripts, { once: true, passive: true });
        });


        const consentBanner = document.getElementById('cookieConsentBanner');
        const acceptBtn = document.getElementById('acceptCookies');
        
        if (consentBanner && acceptBtn) {
          let consentStatus = null;
          try {
            consentStatus = localStorage.getItem('cookieConsent');
          } catch(e){}
          
          if (consentStatus !== 'acknowledged') {
            // Show banner (remove hidden state classes, add visible state classes)
            setTimeout(() => {
              consentBanner.classList.remove('translate-y-8', 'opacity-0', 'pointer-events-none');
              consentBanner.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
            }, 500); // small delay to allow smooth transition on load
            
            acceptBtn.addEventListener('click', () => {
              try { localStorage.setItem('cookieConsent', 'acknowledged'); } catch(e){}
              // Hide banner
              consentBanner.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
              consentBanner.classList.add('translate-y-8', 'opacity-0', 'pointer-events-none');
            });
          }
        }
      })();
    </script>
    <script>
      // WebMCP Support for AI Agents
      if (typeof navigator !== 'undefined' && navigator.modelContext) {
        navigator.modelContext.provideContext({
          tools: [
            {
              name: "contact_developer",
              description: "Open the contact form to message the developer",
              inputSchema: {
                type: "object",
                properties: {}
              },
              execute: async (args) => {
                const navOverlay = document.getElementById("navOverlay");
                const modal = document.getElementById("contactModalOverlay");
                if (navOverlay) {
                  navOverlay.classList.remove("open");
                }
                if (modal) {
                  modal.classList.add("open");
                  return { success: true, message: "Contact form opened." };
                }
                return { success: false, message: "Failed to open contact form." };
              }
            }
          ]
        });
      }
    </script>
  </body>
</html>
