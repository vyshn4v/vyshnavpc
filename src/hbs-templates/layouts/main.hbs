        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://portfolio.vyshnavpc.com/#person",
            "name": "Vyshnav P C",
            "jobTitle": "Software Engineer",
            "url": "https://portfolio.vyshnavpc.com/",
            "sameAs": [
              "https://github.com/vyshn4v",
              "https://linkedin.com/in/vyshn4v"
            ]
          },
          {
            "@type": "ProfessionalService",
            "@id": "https://portfolio.vyshnavpc.com/#service",
            "name": "Vyshnav P C - Software Engineer",
            "description": "Software Engineer specializing in React JS and Node.js. Actively seeking full-time roles.",
            "provider": {
              "@id": "https://portfolio.vyshnavpc.com/#person"
            },
