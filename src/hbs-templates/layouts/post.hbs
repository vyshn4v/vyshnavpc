{{!-- views/post.hbs --}}
{{#section "styles"}}
  <link rel="stylesheet" href="/css/post.css?v=21" />
{{/section}}
{{#section "scripts"}}
  <script src="/js/post.js?v=2"></script>
{{/section}}
{{!-- ── Post Hero (blog post title, meta, etc.) ── --}}
<div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-12 mt-4">
  <div class="border-b-[6px] border-primary pb-2 mb-4 border-t-[6px] pt-4">
    <div class="flex items-center gap-2 text-xs uppercase font-black tracking-widest text-brand-red mb-2" style="color:{{category.color}}">
      {{category.icon}} <span>{{category.label}}</span>
    </div>

    <h1 class="text-5xl sm:text-7xl font-head font-black tracking-tighter text-primary leading-[0.85] uppercase mb-2">
      {{#if titleLine2}}
        {{titleLine1}}<br><span class="text-slate-700">{{titleLine2}}</span>
      {{else}}
        {{title}}
      {{/if}}
    </h1>

    <div class="flex flex-wrap items-center gap-3 text-[10px] font-sans font-bold uppercase tracking-widest text-slate-500">
      <span>{{date}}</span>
      <span>•</span>
      <span>{{readTime}}</span>
      <span>•</span>
      <span>{{meta.tags}}</span>
    </div>
  </div>

{{!-- ── Article body ── --}}
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-6">
    <main class="lg:col-span-8 flex flex-col lg:pr-8 lg:border-r-[2px] border-gray-300">
      <div class="bg-white">
      <article class="post-article">

        {{#if lead}}
          <p class="post-article__lead">{{lead}}</p>
        {{/if}}

        {{!-- Overview section --}}
      {{#if overview}}
        <section id="overview">
          <h2>{{overview.heading}}</h2>
          {{#each overview.paragraphs}}
            <p>{{{this}}}</p>
          {{/each}}

          {{#if overview.callout}}
            {{> callout overview.callout}}
          {{/if}}

          {{#if overview.closing}}
            <p>{{{overview.closing}}}</p>
          {{/if}}
        </section>
      {{/if}}

      {{!-- Dynamic sections --}}
      {{#each sections}}
        <section {{#if id}}id="{{id}}"{{/if}}>
          {{#if heading}}<h2>{{heading}}</h2>{{/if}}
          {{#if intro}}<p class="section-intro">{{intro}}</p>{{/if}}

          {{!-- ── Phase cards grid (Node.js Event Loop) ── --}}
          {{#if phases}}
            <div class="phases-grid">
              {{#each phases}}
                <div class="phase-card" style="--card-accent:{{accent}};--card-color:{{color}}">
                  <div class="phase-num">Phase {{num}}</div>
                  <div class="phase-title">{{icon}} {{title}}</div>
                  <p>{{{desc}}}</p>
                  <span class="tag">{{tag}}</span>
                </div>
              {{/each}}
            </div>
          {{/if}}

          {{!-- ── Interactive loop diagram ── --}}
          {{#if loopDiagram}}
            <div class="diagram-wrap">
              <div class="diagram-label">// {{loopDiagram.label}}</div>
              <div class="loop-tabs">
                {{#each loopDiagram.phases}}
                  <input type="radio" name="loop-phase" id="ph-{{@index}}"{{#if @first}} checked{{/if}}>
                {{/each}}

                <div class="loop-ring">
                  {{#each loopDiagram.phases}}
                    <label for="ph-{{@index}}" class="lp"
                      style="left:{{pos.x}}px;top:{{pos.y}}px;background:{{bg}};border-color:{{border}};">
                      <span class="lp-icon">{{icon}}</span>
                      <span class="lp-name" style="color:{{color}}">{{shortName}}</span>
                    </label>
                  {{/each}}
                  <div class="loop-center">
                    <div class="loop-center-title">Event Loop</div>
                    <div class="loop-center-sub">↻ repeats</div>
                  </div>
                </div>

                <div class="loop-tabs-body">
                  {{#each loopDiagram.phases}}
                    <div class="detail-panel" id="dp-{{@index}}">
                      <div class="detail-phase-name" style="color:{{color}}">{{name}}</div>
                      <div class="detail-phase-desc">{{detailDesc}}</div>
                      <ul class="detail-bullets">
                        {{#each bullets}}
                          <li>
                            <span class="bullet-dot" style="background:{{../color}}"></span>
                            <span>{{this}}</span>
                          </li>
                        {{/each}}
                      </ul>
                    </div>
                  {{/each}}
                </div>

                <div class="phase-nav">
                  <button id="btn-prev" onclick="stepPhase(-1)">← Prev</button>
                  <div class="phase-dots">
                    {{#each loopDiagram.phases}}
                      <label for="ph-{{@index}}" class="phase-dot" title="{{name}}"></label>
                    {{/each}}
                  </div>
                  <button id="btn-next" onclick="stepPhase(1)">Next →</button>
                </div>
              </div>
            </div>
          {{/if}}

          {{!-- ── Steps list (Level 1 — Setup) ── --}}
          {{#if steps}}
            <div class="steps-list">
              {{#each steps}}
                <div class="step-item">
                  <div class="step-number"></div>
                  <div class="step-body">
                    <h3 class="step-title">{{title}}</h3>
                    <p class="step-content">{{{content}}}</p>
                  </div>
                </div>
              {{/each}}
            </div>
          {{/if}}

          {{!-- ── CRUD operation cards (Level 2) ── --}}
          {{#if operations}}
            <div class="operations-grid">
              {{#each operations}}
                <div class="op-card" style="--op-accent:{{accent}}">
                  <div class="op-header">
                    <div class="op-header-top">
                      <span class="op-icon">{{icon}}</span>
                      <span class="op-name">{{op}}</span>
                    </div>
                    <div class="op-methods">
                      {{#each methods}}
                        <code class="op-method">{{this}}</code>
                      {{/each}}
                    </div>
                  </div>
                  <p class="op-desc">{{{desc}}}</p>
                  <div class="op-code"><pre>{{{example}}}</pre></div>
                </div>
              {{/each}}
            </div>
          {{/if}}

          {{!-- ── Operator categories (Level 3 — Querying) ── --}}
          {{#if categories}}
            <div class="operator-categories">
              {{#each categories}}
                <div class="op-category">
                  <h3 class="op-category-title">{{category}}</h3>
                  <div class="op-table">
                    {{#each operators}}
                      <div class="op-row">
                        <code class="op-key">{{op}}</code>
                        <span class="op-def">{{desc}}</span>
                      </div>
                    {{/each}}
                  </div>
                </div>
              {{/each}}
            </div>
          {{/if}}

          {{!-- ── Index type cards (Level 4 — Indexing) ── --}}
          {{#if indexTypes}}
            <div class="index-grid">
              {{#each indexTypes}}
                <div class="index-card">
                  <div class="index-icon">{{icon}}</div>
                  <div class="index-body">
                    <div class="index-type">{{type}}</div>
                    <p class="index-desc">{{{desc}}}</p>
                    <pre class="index-cmd">{{{cmd}}}</pre>
                  </div>
                </div>
              {{/each}}
            </div>
          {{/if}}

          {{!-- ── Aggregation pipeline stages (Level 5) ── --}}
          {{#if stages}}
            <div class="pipeline-stages">
              {{#each stages}}
                <div class="pipeline-stage">
                  <div class="pipeline-connector">
                    {{#unless @first}}<div class="pipe-line"></div>{{/unless}}
                    <div class="stage-badge">
                      <span class="stage-icon">{{icon}}</span>
                    </div>
                    {{#unless @last}}<div class="pipe-line"></div>{{/unless}}
                  </div>
                  <div class="stage-body">
                    <code class="stage-name">{{stage}}</code>
                    <p class="stage-desc">{{{desc}}}</p>
                    {{#if example}}
                      <div class="stage-example"><pre>{{{example}}}</pre></div>
                    {{/if}}
                  </div>
                </div>
              {{/each}}
            </div>
          {{/if}}

          {{!-- ── Advanced topic cards (Level 6) ── --}}
          {{#if topics}}
            <div class="topics-list">
              {{#each topics}}
                <div class="topic-card" style="--topic-accent:{{accent}}">
                  <div class="topic-header">
                    <span class="topic-icon">{{icon}}</span>
                    <h3 class="topic-title">{{title}}</h3>
                  </div>
                  <p class="topic-desc">{{{desc}}}</p>
                  {{#if codeBlock}}
        {{> code-block codeBlock}}
                  {{/if}}
                  {{#if bullets}}
                    <ul class="topic-bullets">
                      {{#each bullets}}
                        <li>
                          <span class="topic-bullet-dot"></span>
                          <span>{{this}}</span>
                        </li>
                      {{/each}}
                    </ul>
                  {{/if}}
                </div>
              {{/each}}
            </div>
          {{/if}}

          {{!-- ── Code block ── --}}
          {{#if codeBlock}}
        {{> code-block codeBlock}}
          {{/if}}

          {{!-- ── Callout ── --}}
          {{#if callout}}
            {{> callout callout}}
          {{/if}}

          {{!-- ── Comparison table — cells pre-typed in JSON, no helpers needed ── --}}
          {{#if table}}
            <div class="table-wrap">
              <table class="compare-table">
                <thead>
                  <tr>
                    {{#each table.columns}}
                      <th>{{this}}</th>
                    {{/each}}
                  </tr>
                </thead>
                <tbody>
                  {{#each table.rows}}
                    <tr>
                      {{#each cells}}
                        <td>
                          {{#if code}}<span class="fn-name">{{value}}</span>{{/if}}
                          {{#if badge}}<span class="badge {{badgeClass}}">{{value}}</span>{{/if}}
                          {{#if text}}{{value}}{{/if}}
                        </td>
                      {{/each}}
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{/if}}

          {{!-- ── Microtask banner ── --}}
          {{#if banner}}
            <div class="microtask-banner">
              <div class="icon">{{banner.icon}}</div>
              <div>
                <h3>{{banner.title}}</h3>
                <p>{{{banner.text}}}</p>
              </div>
            </div>
          {{/if}}

          {{!-- ── Paragraphs ── --}}
          {{#each paragraphs}}
            <p>{{{this}}}</p>
          {{/each}}

        </section>
      {{/each}}

    </article>
      </div>
    </main>
    <aside class="lg:col-span-4 flex flex-col pl-2">
      <div class="sticky top-8">
        <h2 class="text-3xl font-head font-black text-primary mb-4 tracking-tighter border-b-[4px] border-primary pb-2 uppercase">Author</h2>
        <div class="border-[2px] border-primary p-6 mb-8 bg-gray-50">
          <p class="font-sans text-lg font-black uppercase tracking-widest text-primary mb-2">Vyshnav P C</p>
          <p class="font-serif text-sm text-gray-800 leading-relaxed text-justify mb-4">Software Engineer specializing in React JS and Node.js. Obsessed with building scalable, beautiful web applications.</p>
          <a href="/#contact" class="inline-block bg-primary text-white font-sans font-bold uppercase tracking-widest text-xs px-6 py-3 hover:bg-brand-red transition-colors">Contact Me</a>
        </div>
        
        <h2 class="text-3xl font-head font-black text-primary mb-4 tracking-tighter border-b-[4px] border-primary pb-2 uppercase">Share</h2>
        <div class="flex flex-wrap gap-4">
          <a href="#" class="border-[2px] border-primary text-primary px-4 py-2 font-sans font-bold text-xs uppercase tracking-widest hover:bg-primary hover:text-white transition-colors">Twitter</a>
          <a href="#" class="border-[2px] border-primary text-primary px-4 py-2 font-sans font-bold text-xs uppercase tracking-widest hover:bg-primary hover:text-white transition-colors">LinkedIn</a>
          <a href="#" class="border-[2px] border-primary text-primary px-4 py-2 font-sans font-bold text-xs uppercase tracking-widest hover:bg-primary hover:text-white transition-colors">Copy Link</a>
        </div>
      </div>
    </aside>
  </div>
</div>

{{!-- ── Post footer ── --}}
<div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 border-t-[6px] border-primary pt-6 mt-12 mb-12 flex flex-col md:flex-row justify-between items-center gap-4">
  <p class="text-sm font-serif font-bold text-slate-700 italic">{{footer.credit}}</p>
  <div class="flex flex-wrap gap-2 text-[9px] font-sans font-bold uppercase tracking-widest text-white">
    {{#each footer.tags}}
      <span class="bg-primary px-2 py-1">{{this}}</span>
    {{/each}}
  </div>
</div>

{{!-- ── Related posts ── --}}
{{#if related}}
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 mb-12">
    <section class="border-t-4 border-primary pt-8">
      <h3 class="text-3xl font-head font-black text-primary mb-6 tracking-tighter uppercase">Related Coverage</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {{#each related}}
          {{> blog-card this}}
        {{/each}}
      </div>
    </section>
  </div>
{{/if}}
